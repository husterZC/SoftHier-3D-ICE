+int Dram::coreEnergyJ(uint64_t time_ps, double &command_j, double &background_j)
+{
+#ifdef USE_DRAMPOWER
+    if (auto *hbm = dynamic_cast<DRAMPower::SoftHierHBM2 *>(DRAMPower.get()))
+    {
+        hbm->snapshot_ps(time_ps, command_j, background_j);
+        return 0;
+    }
+#endif
+    return 1; // Power disabled or a different backend; never silently report zero.
+}
+
 void Dram::reportPower()
 {
+#ifdef USE_DRAMPOWER
+    if (dynamic_cast<DRAMPower::SoftHierHBM2 *>(DRAMPower.get()))
+    {
+        double command_j = 0.0, background_j = 0.0;
+        const uint64_t time_ps = sc_time_stamp() / sc_time(1, SC_PS);
+        coreEnergyJ(time_ps, command_j, background_j);
+        const auto saved_flags = std::cout.flags();
+        const auto saved_precision = std::cout.precision();
+        std::cout << std::scientific << std::setprecision(9)
+                  << name() << "  HBM2 Core Energy: " << command_j + background_j
+                  << " J (command " << command_j << ", background " << background_j << ")" << std::endl;
+        std::cout.flags(saved_flags);
+        std::cout.precision(saved_precision);
+        return;
+    }
+#endif
     if (!DRAMPower)
         return;
 
