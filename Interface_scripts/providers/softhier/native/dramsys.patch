+// ABI version is also a build-cache capability marker. Energies are cumulative J.
+extern "C" int softhier_dram_energy_abi_version() { return 1; }
+extern "C" int dram_get_core_energy_j(int dram_id, uint64_t time_ps,
+                                      double *command_j, double *background_j)
+{
+    if (!command_j || !background_j || dram_id < 0 ||
+        static_cast<size_t>(dram_id) >= list_of_DRAMsys.size()) return -1;
+    try
+    {
+        return list_of_DRAMsys[dram_id]->coreEnergyJ(time_ps, *command_j, *background_j);
+    }
+    catch (const std::exception &error)
+    {
+        std::cerr << "HBM2 energy snapshot failed: " << error.what() << std::endl;
+        return -1;
+    }
+}
