+
+int DRAMSys::coreEnergyJ(uint64_t time_ps, double &command_j, double &background_j)
+{
+    command_j = background_j = 0.0;
+    for (auto &dram : drams)
+    {
+        double commands = 0.0, background = 0.0;
+        const int status = dram->coreEnergyJ(time_ps, commands, background);
+        if (status != 0) return status;
+        command_j += commands;
+        background_j += background;
+    }
+    return drams.empty() ? 1 : 0;
 }
 
