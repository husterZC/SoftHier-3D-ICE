 void vp::BlockPower::get_total_energy(double *dynamic, double *leakage)
 {
     this->get_power_trace()->get_total_energy(dynamic, leakage);
+    this->get_external_energy(this->top.time.get_time(), dynamic, leakage);
+}
+
+void vp::BlockPower::get_external_energy(int64_t time_ps, double *dynamic, double *leakage)
+{
+    if (this->external_energy_callback)
+    {
+        double external_dynamic = 0.0, external_leakage = 0.0;
+        this->external_energy_callback(time_ps, &external_dynamic, &external_leakage);
+        *dynamic += external_dynamic;
+        *leakage += external_leakage;
+    }
+    for (auto child : this->top.get_childs())
+    {
+        child->power.get_external_energy(time_ps, dynamic, leakage);
+    }
 }
 
